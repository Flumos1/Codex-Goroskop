# Normalize line endings in the repo to LF regardless of the checkout OS,
# so `git status` doesn't show every text file as modified on Windows
# (core.autocrlf=true) after any unrelated git operation. Placed first so
# the binary/LFS rules below (more specific, listed later) win for text.
* text=auto eol=lf

*.pdf filter=lfs diff=lfs merge=lfs -text
*.docx filter=lfs diff=lfs merge=lfs -text
