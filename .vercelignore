# Only the serverless function's runtime files should be uploaded.
# The function needs: site/**, lib/**, data/*.json, package*.json, vercel.json.
# Everything below is research/build material the running server never reads.

node_modules
.git

# 2.7 GB of source book PDFs — never needed at runtime
sources

# Bulk data: OCR text, caches, knowledge graph. The server only reads the
# small data/*.json files (places, palmistry-rules, hebrew-calendar-months),
# which are NOT ignored below.
data/extracted-text
data/ocr-page-cache
data/ocr-runs
data/knowledge-graph

# Research / authoring material — not used by site/server.cjs
research
knowledge-base
methodology
docs
scripts

# generator/ and tools/ ARE needed at runtime (lib requires tools/*.cjs;
# generate-report reads generator/rules/*.json), so they are NOT ignored.
# Exclude only generator's build outputs/samples.
generator/outputs
generator/samples

*.zip
